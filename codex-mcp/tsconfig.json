{
  "extends": "../web-ui/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*",
    "src/.codex-plugin/**/*.json",
    "src/mcp/servers.mcp.json"
  ],
  "exclude": ["__tests__", "dist", "scripts", "src/**/*.mjs"]
}
