{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*",
    "src/.codex-plugin/**/*.json",
    "src/.mcp.json"
  ],
  "exclude": ["__tests__", "dist", "scripts", "src/**/*.test.mjs"]
}
