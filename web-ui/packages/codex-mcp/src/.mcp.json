{
	"mcpServers": {
		"resource-server": {
			"command": "node",
			"args": [
				"./src/scripts/oauth-mcp-wrapper.mjs"
			],
			"env": {
				"MCP_COMPLIANCE_THEATER_RESOURCE_SERVER_URL": "${MCP_COMPLIANCE_THEATER_RESOURCE_SERVER_URL:-http://localhost:3000/api/ai/tools/sse}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_AUTH_ISSUER": "${MCP_COMPLIANCE_THEATER_RESOURCE_AUTH_ISSUER:-https://login.obapps.net/realms/compliance-theater}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_OAUTH_SCOPE": "${MCP_COMPLIANCE_THEATER_RESOURCE_OAUTH_SCOPE:-openid}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_CLIENT_ID": "${MCP_COMPLIANCE_THEATER_RESOURCE_CLIENT_ID:-codex}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_CLIENT_SECRET": "${MCP_COMPLIANCE_THEATER_RESOURCE_CLIENT_SECRET}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_MCP_COMMAND": "${MCP_COMPLIANCE_THEATER_RESOURCE_MCP_COMMAND}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_MCP_ARGS": "${MCP_COMPLIANCE_THEATER_RESOURCE_MCP_ARGS}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_TIMEOUT_MS": "${MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_TIMEOUT_MS}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_RETRY_COUNT": "${MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_RETRY_COUNT}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_RETRY_BASE_MS": "${MCP_COMPLIANCE_THEATER_RESOURCE_HTTP_RETRY_BASE_MS}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_PROXY_REQUEST_TIMEOUT_MS": "${MCP_COMPLIANCE_THEATER_RESOURCE_PROXY_REQUEST_TIMEOUT_MS}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_DEVICE_CODE_TIMEOUT_SECONDS": "${MCP_COMPLIANCE_THEATER_RESOURCE_DEVICE_CODE_TIMEOUT_SECONDS}",
				"MCP_COMPLIANCE_THEATER_RESOURCE_CHILD_ACCESS_TOKEN_ENV": "MCP_COMPLIANCE_THEATER_RESOURCE_ACCESS_TOKEN"
			}
		}
	}
}