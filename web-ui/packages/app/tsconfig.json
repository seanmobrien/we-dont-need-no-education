{
  "extends": "../../tsconfig.next.json",
  "compilerOptions": {
    "noEmit": true,
    "noImplicitAny": false,
    // "ignoreDeprecations": "6.0",
    // Allow source imports from sibling frontend packages and submodules under web-ui/.
    "rootDir": "../../",
    "baseUrl": ".",
    "composite": false,
    "customConditions": [
      "development"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@semanticencoding/core": [
        "../../submodules/sce/packages/core/ts/src/index.ts"
      ]
    },
    // Explicit types prevent accidental inclusion of @types packages (for
    // example mocha) that collide with jest globals in the monorepo.
    // We include node + jest here so tests and runtime node types are
    // available while preventing other ambient test typings from leaking in.
    "types": [
      "node",
      "jest"
    ],
  },
  "include": [
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "tests",
    "**/__tests__/**",
    "**/__mocks__/**",
    "node_modules",
    ".upstream/**/*.*",
    "**/.upstream/**/*.*",
    "submodules/**/*.*",
    ".next",
    "dist"
  ]
}
