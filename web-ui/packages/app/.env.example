# =============================================================================
# ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# DO NOT commit .env.local to version control
# =============================================================================

# =============================================================================
# CORE APPLICATION
# =============================================================================

# Node environment (development | production | test)
NODE_ENV=development

# Next.js Auth Secret - REQUIRED
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-min-32-chars

# Application hostname (used for OAuth redirects and API URLs)
NEXT_PUBLIC_HOSTNAME=http://localhost:3000

# Server-side log level (silly | debug | verbose | info | warn | error)
LOG_LEVEL_SERVER=warn

# Client-side log level (silly | debug | verbose | info | warn | error)
NEXT_PUBLIC_LOG_LEVEL_CLIENT=silly

# =============================================================================
# DATABASE - PostgreSQL (REQUIRED)
# =============================================================================

# Primary database URL (pooled connection)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: Unpooled connection for migrations/long-running operations
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/dbname

# =============================================================================
# AZURE OPENAI - AI Services (REQUIRED for AI features)
# =============================================================================

# Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API key
AZURE_API_KEY=your-azure-openai-key

# Deployment names for different models
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4
AZURE_OPENAI_DEPLOYMENT_HIFI=gpt-4
AZURE_OPENAI_DEPLOYMENT_LOFI=gpt-35-turbo
AZURE_OPENAI_DEPLOYMENT_COMPLETIONS=gpt-4

# Optional: Separate endpoints/keys for embedding and completions
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-ada-002
AZURE_OPENAI_ENDPOINT_EMBEDDING=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY_EMBEDDING=your-azure-openai-key
AZURE_OPENAI_ENDPOINT_COMPLETIONS=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY_COMPLETIONS=your-azure-openai-key

# Default AI model type for client (hifi | lofi)
NEXT_PUBLIC_DEFAULT_AI_MODEL=hifi

# =============================================================================
# AZURE AI SEARCH - Vector Search & Document Indexing (REQUIRED for search)
# =============================================================================

# Azure AI Search endpoint
AZURE_AISEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Azure AI Search admin key
AZURE_AISEARCH_KEY=your-search-admin-key

# Index names
AZURE_AISEARCH_DOCUMENTS_INDEX_NAME=documents
AZURE_AISEARCH_POLICY_INDEX_NAME=policies

# Vector dimensions (default: 1536 for small, 3072 for large)
AZURE_AISEARCH_VECTOR_SIZE_SMALL=1536
AZURE_AISEARCH_VECTOR_SIZE_LARGE=3072

# Document chunking configuration
AZURE_AISEARCH_DOCUMENT_SPLITTER_OVERLAP=200
AZURE_AISEARCH_DOCUMENT_SPLITTER_MAX_TOKENS=8000

# Token batch threshold for processing
TOKEN_BATCH_THRESHOLD=8000

# =============================================================================
# AZURE STORAGE - Blob Storage (REQUIRED for file uploads)
# =============================================================================

# Azure Storage connection string (includes account key)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# Or use separate account name and key
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key

# =============================================================================
# AZURE MONITOR - Application Insights (OPTIONAL)
# =============================================================================

# Application Insights connection string for telemetry
NEXT_PUBLIC_AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# =============================================================================
# GOOGLE AUTHENTICATION - OAuth (REQUIRED for Google login)
# =============================================================================

# Google OAuth Client ID and Secret
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Google API Key (for additional Google services)
AUTH_GOOGLE_APIKEY=your-google-api-key

# =============================================================================
# GOOGLE GENERATIVE AI - Alternative AI Provider (OPTIONAL)
# =============================================================================

# Google Generative AI API Key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Google AI API base URL (default: https://generativelanguage.googleapis.com)
GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com

# Model names for different quality tiers
GOOGLE_GENERATIVE_HIFI=gemini-pro
GOOGLE_GENERATIVE_LOFI=gemini-1.5-flash
GOOGLE_GENERATIVE_EMBEDDING=embedding-001

# Chrome DevTools workspace ID (for debugging)
GOOGLE_CHROME_DEVTOOLS_WORKSPACE_ID=

# =============================================================================
# OPENAI - Alternative AI Provider (OPTIONAL)
# =============================================================================

# OpenAI API Key (if not using Azure OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model names
OPENAI_HIFI=gpt-4-turbo-preview
OPENAI_LOFI=gpt-3.5-turbo
OPENAI_EMBEDDING=text-embedding-3-small

# =============================================================================
# KEYCLOAK - Enterprise SSO (OPTIONAL)
# =============================================================================

# Keycloak OAuth Configuration
AUTH_KEYCLOAK_CLIENT_ID=your-keycloak-client-id
AUTH_KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=https://your-keycloak-server.com/realms/your-realm
AUTH_KEYCLOAK_SCOPE=openid profile email

# Keycloak redirect URI (auto-generated from NEXT_PUBLIC_HOSTNAME if not set)
AUTH_KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

# Keycloak impersonation settings
AUTH_KEYCLOAK_IMPERSONATION_AUDIENCE=account
AUTH_KEYCLOAK_IMPERSONATOR_USERNAME=admin-username
AUTH_KEYCLOAK_IMPERSONATOR_PASSWORD=admin-password
AUTH_KEYCLOAK_IMPERSONATOR_OFFLINE_TOKEN=your-offline-refresh-token

# MCP Tool Resource Configuration
AUTH_KEYCLOAK_MCP_TOOL_RESOURCE_NAME=mcp-tools
AUTH_KEYCLOAK_MCP_TOOL_RESOURCE_ID=mcp-tools-resource-id

# =============================================================================
# REDIS - Caching & Session Storage (REQUIRED)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (if authentication is enabled)
REDIS_PASSWORD=your-redis-password

# =============================================================================
# FLAGSMITH - Feature Flags (REQUIRED)
# =============================================================================

# Flagsmith server-side SDK key
FLAGSMITH_SDK_KEY=your-flagsmith-server-sdk-key

# Flagsmith client-side configuration (public)
NEXT_PUBLIC_FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_ID=your-flagsmith-environment-id

# =============================================================================
# MEM0 - AI Memory Service (OPTIONAL)
# =============================================================================

# Mem0 API configuration
MEM0_API_HOST=https://api.mem0.ai
MEM0_API_BASE_PATH=api/v1
MEM0_UI_HOST=https://app.mem0.ai

# Mem0 authentication
MEM0_USERNAME=your-mem0-username
MEM0_API_KEY=your-mem0-api-key

# Mem0 organization and project IDs (optional)
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# =============================================================================
# MATERIAL-UI - License (OPTIONAL for Pro/Premium features)
# =============================================================================

NEXT_PUBLIC_MUI_LICENSE=your-mui-x-license-key

# =============================================================================
# DATA GRID - Client Configuration
# =============================================================================

# Cache timeout for client-side data grid (milliseconds)
# Default: 300000 (5 minutes)
NEXT_PUBLIC_DATAGRID_CLIENT_CACHE_TIMEOUT=300000

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Local development: bypass authentication for specific user ID
# WARNING: Never use in production!
LOCAL_DEV_AUTH_BYPASS_USER_ID=

# =============================================================================
# NOTES
# =============================================================================
# 
# Required Variables:
# - AUTH_SECRET
# - DATABASE_URL
# - NEXT_PUBLIC_HOSTNAME
# - AZURE_OPENAI_ENDPOINT + AZURE_API_KEY (or alternative AI provider)
# - AZURE_AISEARCH_ENDPOINT + AZURE_AISEARCH_KEY
# - AZURE_STORAGE_CONNECTION_STRING
# - AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET
# - REDIS_URL + REDIS_PASSWORD
# - FLAGSMITH_SDK_KEY + NEXT_PUBLIC_FLAGSMITH_*
#
# Public Variables (NEXT_PUBLIC_*):
# These variables are exposed to the browser and inlined into the client bundle.
# NEVER put sensitive data in NEXT_PUBLIC_* variables!
#
# For more information, see:
# - packages/app/lib/site-util/env/README.md
# - https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
