{
  "name": "@compliance-theater/react-query-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-safe React Query compatibility boundary for internal workspace consumers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "development": "./src/devtools.tsx",
      "default": "./dist/devtools.js"
    },
    "./devtools/production": {
      "types": "./dist/devtools.production.d.ts",
      "development": "./src/devtools.production.tsx",
      "default": "./dist/devtools.production.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "development": "./src/runtime.tsx",
      "default": "./dist/runtime.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.12.0"
  },
  "scripts": {
    "add": "yarn workspace @compliance-theater/react-query-compat add ",
    "build": "yarn run build:typescript",
    "build:publish": "yarn run build",
    "build:typescript": "echo 'Building @compliance-theater/react-query-compat...' && tsc -b tsconfig.json && echo '\u001b[1;32mBuild complete: @compliance-theater/react-query-compat.\u001b[0m\n' || (echo '\u001b[31mBuild failed: @compliance-theater/react-query-compat.\u001b[0m\n' >&2; exit 1)",
    "test": "jest --coverage",
    "test:unit": "jest",
    "lint": "yarn exec eslint src --ext .js,.jsx,.ts,.tsx --config ../../eslint.config.mjs",
    "build:clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.3",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
