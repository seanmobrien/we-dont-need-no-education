{
  "name": "@compliance-theater/auth-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-safe auth compatibility boundary for internal workspace consumers (next-auth, @auth/core, drizzle adapter)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "development": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.12.0"
  },
  "scripts": {
    "add": "yarn workspace @compliance-theater/auth-compat add ",
    "build": "yarn run build:typescript",
    "build:publish": "yarn run build",
    "build:typescript": "echo 'Building @compliance-theater/auth-compat...' && tsc -b tsconfig.json && echo '\u001b[1;32mBuild complete: @compliance-theater/auth-compat.\u001b[0m\n' || (echo '\u001b[31mBuild failed: @compliance-theater/auth-compat.\u001b[0m\n' >&2; exit 1)",
    "test": "jest --coverage",
    "test:unit": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --config ../../eslint.config.mjs",
    "build:clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@auth/drizzle-adapter": "^1.4.1",
    "next-auth": "^5.0.0-beta.30"
  },
  "peerDependenciesMeta": {
    "@auth/core": {
      "optional": true
    },
    "@auth/drizzle-adapter": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "25.2.3",
    "jest": "^30.0.5",
    "jest-environment-node": "^30.0.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
