{
  "name": "@compliance-theater/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript type definitions for AI and chat functionality",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./dependency-injection": {
      "types": "./dist/dependency-injection/index.d.ts",
      "development": "./src/dependency-injection/index.ts",
      "default": "./dist/dependency-injection/index.js"
    },
    "./dependency-injection/container": {
      "types": "./dist/dependency-injection/container.d.ts",
      "development": "./src/dependency-injection/container.ts",
      "default": "./dist/dependency-injection/container.js"
    },
    "./singleton-provider": {
      "types": "./dist/lib/logger/singleton-provider.d.ts",
      "development": "./src/lib/logger/singleton-provider.ts",
      "default": "./dist/lib/logger/singleton-provider.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "development": "./src/types/*",
      "default": "./dist/types/*.js"
    },
    "./typescript": {
      "types": "./dist/types/typescript/index.d.ts",
      "development": "./src/types/typescript/index.ts",
      "default": "./dist/types/typescript/index.js"
    },
    "./typescript/*": {
      "types": "./dist/types/typescript/*.d.ts",
      "development": "./src/types/typescript/*",
      "default": "./dist/types/typescript/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.12.0"
  },
  "scripts": {
    "add": "yarn workspace @compliance-theater/types add ",
    "build": "yarn build:typescript",
    "build:publish": "yarn run build",
    "build:typescript": "echo 'Building lib/types...' && tsc -b tsconfig.json && echo '\\u001b[1;32mBuild complete: @compliance-theater/types.\\u001b[0m\\n' || (echo '\\u001b[31mBuild failed: @compliance-theater/types.\\u001b[0m\\n' >&2; exit 1)",
    "test": "jest --coverage",
    "test:unit": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --config ../../eslint.config.mjs",
    "build:clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/gateway": "2.0.65",
    "@ai-sdk/provider": "2.0.1",
    "@ai-sdk/provider-utils": "3.0.22",
    "@compliance-theater/auth-compat": "workspace:*",
    "awilix": "^13.0.0",
    "next": "^15.5.12",
    "react-native": "^0.84.0",
    "ts-pattern": "^5.7.1"
  },
  "peerDependencies": {
    "ai": "^5.0.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "jest": "^30.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
