{
  "name": "compliance-theater",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.12.0"
  },
  "workspaces": [
    "web-ui/packages/*",
    "web-ui/submodules/json-viewer/packages",
    "web-ui/submodules/sce",
    "web-ui/submodules/sce/packages/*/ts"
  ],
  "scripts": {
    "add": "turbo run add --filter='@compliance-theater/*' ",
    "preinstall": "node preinstall.js",
    "link:clean": "node scripts/link-clean.mjs",
    "link:clean:sh": "bash scripts/clean-link.sh",
    "link:clean:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-link.ps1",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "dev": "turbo run dev --filter='@compliance-theater/app...'",
    "debug": "turbo run debug --filter='@compliance-theater/app...'",
    "build": "turbo run build --filter='@compliance-theater/app...' --continue=dependencies-successful",
    "build:debug": "yarn workspace @compliance-theater/app build:debug",
    "build:partial": "turbo run build --filter='@compliance-theater/app...' --continue=dependencies-successful",
    "build:typescript": "turbo run build:typescript --filter='@compliance-theater/app...' --continue=dependencies-successful",
    "build:typescript:partial": "turbo run build:typescript --filter='@compliance-theater/app...' --continue=dependencies-successful",
    "build:publish": "cross-env YARN_IGNORE_PATH=1 turbo run build:publish --filter='@compliance-theater/app...'",
    "build:clean": "turbo run build:clean --filter='@compliance-theater/app...'",
    "test": "turbo run test --filter='@compliance-theater/app...' -- ",
    "test:coverage": "turbo run test --filter='@compliance-theater/app...'  --continue=dependencies-successful -- --coverage",
    "test:fast": "turbo run test --filter='@compliance-theater/app...'  --continue=dependencies-successful  -- ",
    "test:unit": "turbo run test:unit --filter='@compliance-theater/app...' -- --coverage",
    "test:e2e": "turbo run test:e2e --filter='@compliance-theater/app...'  -- ",
    "lint": "turbo run lint --filter='@compliance-theater/app...'",
    "ci:install": "yarn install",
    "ci:build": "yarn build",
    "ci:test": "yarn test",
    "vercel-build": "yarn run ci:build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.0.5",
    "@playwright/test": "^1.55.0",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "canvas": "^3.2.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-mock-extended": "^4.0.0-beta1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "rimraf": "^6.1.2",
    "ts-jest": "^30.0.0",
    "ts-node": "^10.9.1",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "undici": "^7.16.0",
    "web-streams-polyfill": "^4.2.0"
  },
  "resolutions": {
    "@compliance-theater/json-viewer": "workspace:*",
    "semanticencoding": "workspace:*",
    "@ai-sdk/gateway": "2.0.65",
    "@ai-sdk/provider": "2.0.1",
    "@ai-sdk/provider-utils": "3.0.22",
    "@emotion/cache": "11.14.0",
