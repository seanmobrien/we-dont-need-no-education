    "next-mdx-remote": "6.0.0",
    "@theguild/remark-mermaid": "0.3.0",
    "react-is": "19.2.4",
    "react-refresh": "0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.0",
    "zod": "3.25.76",
