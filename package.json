    "@jest/environment": "30.2.0",
    "@jest/fake-timers": "30.2.0",
    "@jest/schemas": "30.0.5",
    "@jest/transform": "30.2.0",
    "@jest/types": "30.2.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "eslint-visitor-keys": "5.0.1",
    "jest-environment-node": "30.2.0",
    "jest-haste-map": "30.2.0",
